#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
    steering_servo: zephyr,user {
        pwms = <&pwm3 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>,
               <&pwm5 1 PWM_USEC(100) PWM_POLARITY_NORMAL>,
               <&pwm5 2 PWM_USEC(100) PWM_POLARITY_NORMAL>;
    };
};

/* PA6/PA7 are debug GPIO outputs (see debug_pins.c), not SPI1 MISO/MOSI */
&spi1 {
    status = "disabled";
};

/* Left encoder */
&timers1 {
    status = "okay";
    st,prescaler = <0>;

    pwm {
        status = "disabled";
    };

    left_encoder: qdec {
        compatible = "st,stm32-qdec";
        status = "okay";

        pinctrl-0 = <&tim1_ch1_pa8 &tim1_ch2_pa9>;
        pinctrl-names = "default";

        st,encoder-mode = <3>;
        st,input-filter-level = <3>;
        st,counts-per-revolution = <1>;
    };
};

/* Right encoder */
&timers2 {
    status = "okay";
    st,prescaler = <0>;

    pwm {
        status = "disabled";
    };

    right_encoder: qdec {
        compatible = "st,stm32-qdec";
        status = "okay";

        pinctrl-0 = <&tim2_ch1_pa15 &tim2_ch2_pb3>;
        pinctrl-names = "default";

        st,encoder-mode = <3>;
        st,input-filter-level = <3>;
        st,counts-per-revolution = <1>;
    };
};

/* Steering servo on PB4 */
&timers3 {
    status = "okay";
    st,prescaler = <83>;

    pwm3: pwm {
        status = "okay";
        pinctrl-0 = <&tim3_ch1_pb4>;
        pinctrl-names = "default";
    };
};

/* Motor enables: ENA on PA0, ENB on PA1 */
&timers5 {
    status = "okay";
    st,prescaler = <83>;

    pwm5: pwm {
        status = "okay";
        pinctrl-0 = <&tim5_ch1_pa0 &tim5_ch2_pa1>;
        pinctrl-names = "default";
    };
};

/* Pi connection */
&usart1 {
    pinctrl-0 = <&usart1_tx_pb6 &usart1_rx_pb7>;
    pinctrl-names = "default";
    current-speed = <115200>;
    status = "okay";
};

/* Current sensors */
&adc1 {
    pinctrl-0 = <&adc1_in4_pa4 &adc1_in8_pb0 &adc1_in11_pc1>;
    pinctrl-names = "default";
    status = "okay";
};