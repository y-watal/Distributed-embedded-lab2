/*
 * N2 (front, steering): two MCP2515 CAN modules on SPI1, the Lab 2 steering
 * servo and servo current sensor, and the Lab 3 test points.
 * Full pin and breadboard-row map: docs/lab3_pin_map.md
 */
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	aliases {
		can-a = &can_a;
		can-b = &can_b;
	};

	zephyr,user {
		/* Test points (src/tp.c). Rows 1-2 of the test-point board are GND. */
		can-rx-a-gpios = <&gpioa 0 GPIO_ACTIVE_HIGH>;	/* row 3:  CAN_RX_A, A0 / PA0 */
		can-rx-b-gpios = <&gpioa 1 GPIO_ACTIVE_HIGH>;	/* row 4:  CAN_RX_B, A1 / PA1 */
		can-tx-a-gpios = <&gpioa 4 GPIO_ACTIVE_HIGH>;	/* row 5:  CAN_TX_A, A2 / PA4 */
		can-tx-b-gpios = <&gpiob 0 GPIO_ACTIVE_HIGH>;	/* row 6:  CAN_TX_B, A3 / PB0 */
		deg-a-gpios    = <&gpiob 8 GPIO_ACTIVE_HIGH>;	/* row 7:  DEG_A,    D15 / PB8, LED */
		deg-b-gpios    = <&gpioc 0 GPIO_ACTIVE_HIGH>;	/* row 8:  DEG_B,    A5 / PC0, LED */
		srv-gpios      = <&gpiob 9 GPIO_ACTIVE_HIGH>;	/* row 9:  SRV,      D14 / PB9: toggles on each servo duty set (servo PWM itself: D5 / PB4) */
		fl-gpios       = <&gpiob 10 GPIO_ACTIVE_HIGH>;	/* row 10: FL,       D6 / PB10, LED */
		fr-gpios       = <&gpioa 8 GPIO_ACTIVE_HIGH>;	/* row 11: FR,       D7 / PA8,  LED */
		relay-tx-gpios = <&gpioa 9 GPIO_ACTIVE_HIGH>;	/* row 12: RELAY_TX, D8 / PA9 */
		err-gpios      = <&gpiob 3 GPIO_ACTIVE_HIGH>;	/* row 13: ERR,      D3 / PB3 */

		/* Steering servo (src/servo.c), 50 Hz, as in Lab 2 */
		pwms = <&pwm3 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		pwm-names = "servo";
	};
};

/* ---- Board defaults that sit on pins this node uses ---- */
/* ---- Independent watchdog (src/watchdog.c); the window watchdog stays off ---- */
&iwdg { status = "okay"; };
&wwdg { status = "disabled"; };

&usart1 { status = "disabled"; };	/* PB6/PB7: PB6 is CAN A chip select */
&i2c1 { status = "disabled"; };		/* PB8/PB9: DEG_A, SRV */
&i2c3 { status = "disabled"; };		/* PA8/PC9: PA8 is FR */
&pwm2 { status = "disabled"; };		/* PWM LED on PA5 = SPI1 SCK */
&timers2 { status = "disabled"; };

/* ---- Servo PWM on D5 / PB4 (TIM3_CH1), 1 MHz timer tick (Lab 2) ---- */
&timers3 {
	status = "okay";
	st,prescaler = <83>;

	pwm3: pwm {
		status = "okay";
		pinctrl-0 = <&tim3_ch1_pb4>;
		pinctrl-names = "default";
	};
};

/* ---- Servo current sensor: PC1 = ADC1_IN11 (Lab 2) ---- */
&adc1 {
	pinctrl-0 = <&adc1_in11_pc1>;
	pinctrl-names = "default";
	status = "okay";
};

/*
 * ---- Two XIAO CAN modules (MCP2515 + SN65HVD230) on SPI1 ----
 *
 *   Module   Function   Nucleo
 *   D8       SCK        D13 / PA5   (shared)
 *   D10      MOSI       D11 / PA7   (shared)
 *   D9       MISO       D12 / PA6   (shared)
 *   D7       CS         CAN A: D10 / PB6    CAN B: D9 / PC7
 *   D6       INT        CAN A: D2  / PA10   CAN B: D4 / PB5
 *
 * osc-freq must match the crystal printed on the module's metal can.
 */
&spi1 {
	status = "okay";
	cs-gpios = <&gpiob 6 GPIO_ACTIVE_LOW>,	/* reg 0: CAN A */
		   <&gpioc 7 GPIO_ACTIVE_LOW>;	/* reg 1: CAN B */

	can_a: can@0 {
		compatible = "microchip,mcp2515";
		reg = <0>;
		/* 4 MHz: at 1 MHz, back-to-back frames were being lost on a node with one bus unplugged. MCP2515 max is 10 MHz. */
		spi-max-frequency = <4000000>;
		int-gpios = <&gpioa 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		osc-freq = <16000000>;
		bitrate = <500000>;
		status = "okay";
	};

	can_b: can@1 {
		compatible = "microchip,mcp2515";
		reg = <1>;
		spi-max-frequency = <4000000>;
		int-gpios = <&gpiob 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
		osc-freq = <16000000>;
		bitrate = <500000>;
		status = "okay";
	};
};
